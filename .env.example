# Banco de dados MySQL
# Local (docker-compose): mysql://root:root@localhost:3306/zapvenda
# Azure MySQL: mysql://USER:PASSWORD@HOST.mysql.database.azure.com:3306/zapvenda?sslaccept=strict
DATABASE_URL="mysql://root:root@localhost:3306/zapvenda"

# Segredo do Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Admin inicial (criado/atualizado automaticamente no startup via seed)
ADMIN_EMAIL="joab@lustosa.tech"
ADMIN_PASSWORD="0bgmtfs0"
ADMIN_NAME="Joab"

# OpenAI (pode também ser configurado pela tela de Settings)
OPENAI_API_KEY=""

# WhatsApp Cloud API (pode também ser configurado pela tela de Settings)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="meu-verify-token"

# URL pública base (usada para montar o link de agendamento)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Chave de agente para publicar notícias via API (header x-api-key).
# Usada pela automação de curadoria (skill curadoria-noticias). Também pode ser
# configurada como Setting "newsApiKey" no banco. Gere com:
#   node -e "console.log('news_'+require('crypto').randomBytes(24).toString('hex'))"
NEWS_API_KEY=""
# Base da API para os scripts de automação (default: https://lustosatech.com)
NEWS_API_BASE="https://lustosatech.com"
