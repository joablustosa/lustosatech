# Banco de dados (SQLite local)
DATABASE_URL="file:./dev.db"

# Segredo do Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Admin inicial (usado pelo seed)
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# OpenAI (pode também ser configurado pela tela de Settings)
OPENAI_API_KEY=""

# WhatsApp Cloud API (pode também ser configurado pela tela de Settings)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="meu-verify-token"

# URL pública base (usada para montar o link de agendamento)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
