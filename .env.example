# Banco de dados MySQL
# Local (docker-compose): mysql://root:root@localhost:3306/zapvenda
# Azure MySQL: mysql://USER:PASSWORD@HOST.mysql.database.azure.com:3306/zapvenda?sslaccept=strict
DATABASE_URL="mysql://root:root@localhost:3306/zapvenda"

# Segredo do Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Admin inicial (criado/atualizado automaticamente no startup via seed)
ADMIN_EMAIL="joab@lustosa.tech"
ADMIN_PASSWORD="0bgmtfs0"
ADMIN_NAME="Joab"

# ===== Chaves de IA (centrais da empresa — somente via env) =====
# O consumo das IAs é cobrado de forma centralizada; essas chaves NÃO são
# configuráveis por tenant na tela de Settings.
# OpenAI — agente de conversa, roteiros e divisão de cenas
OPENAI_API_KEY=""
# Gemini (Veo) — gera os clipes de vídeo de cada cena
GEMINI_API_KEY=""
# ElevenLabs — gera o áudio de narração de cada cena
ELEVENLABS_API_KEY=""
# Voz padrão do ElevenLabs (opcional; default: Rachel). Cada vídeo pode
# escolher a própria voz no calendário de postagens.
ELEVENLABS_VOICE_ID=""
# Webhook que recebe o vídeo final (também configurável por tenant em Settings).
# Opcional: sem ele, o vídeo final fica disponível no Azure Blob (finalVideoUrl).
VIDEO_WEBHOOK_URL=""

# Azure Blob Storage — armazena clipes, narrações, vídeo final e imagens de
# notícias. Também pode ser configurado como Setting "azureStorageConnection".
AZURE_STORAGE_CONNECTION_STRING=""
# Container usado para os uploads (default: news-media)
AZURE_STORAGE_CONTAINER=""

# WhatsApp Cloud API (pode também ser configurado pela tela de Settings)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="meu-verify-token"

# URL pública base (usada para montar o link de agendamento)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Chave de agente para publicar notícias via API (header x-api-key).
# Usada pela automação de curadoria (skill curadoria-noticias). Também pode ser
# configurada como Setting "newsApiKey" no banco. Gere com:
#   node -e "console.log('news_'+require('crypto').randomBytes(24).toString('hex'))"
NEWS_API_KEY=""
# Base da API para os scripts de automação (default: https://lustosatech.com)
NEWS_API_BASE="https://lustosatech.com"
