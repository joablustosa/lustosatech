generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Base de conhecimento: documentos .md sobre a empresa
model Document {
  id        String   @id @default(cuid())
  title     String
  filename  String?
  content   String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Uma conversa por contato de WhatsApp
model Conversation {
  id            String    @id @default(cuid())
  waPhone       String    @unique
  contactName   String?
  status        String    @default("ativo") // ativo | agendado | fechado
  reportJson    String?   @db.Text // relatório gerado por IA (JSON)
  reportAt      DateTime?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]
  meetings      Meeting[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // in | out
  type           String       @default("text") // text | image | audio
  content        String       @db.Text // texto, transcrição de áudio ou descrição de imagem
  mediaUrl       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model AvailabilitySlot {
  id        String    @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  isBooked  Boolean   @default(false)
  createdAt DateTime  @default(now())
  meeting   Meeting?
}

model Meeting {
  id             String            @id @default(cuid())
  conversationId String?
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  slotId         String            @unique
  slot           AvailabilitySlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clientName     String
  clientPhone    String?
  clientEmail    String?
  notes          String?           @db.Text
  status         String            @default("confirmado") // confirmado | cancelado | realizado
  createdAt      DateTime          @default(now())
}

/// Configurações (chave/valor). Segredos podem vir daqui ou do .env.
model Setting {
  key   String @id
  value String @db.Text
}

/// Notícias do portal de IA
model News {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String   @default("Novidades") // Novidades | Pesquisa | Produto | Política | Opinião | Mercado
  excerpt       String   @db.Text // resumo curto exibido nos cards
  content       String   @db.Text // corpo em markdown
  coverImageUrl String? // imagem de capa (Azure Blob)
  mediaType     String   @default("image") // image | video
  mediaUrl      String? // vídeo (Azure Blob) quando mediaType = video
  author        String?
  source        String?
  sourceUrl     String?
  tags          String?  @db.Text // tags separadas por vírgula
  featured      Boolean  @default(false) // destaque no topo do portal
  status        String   @default("published") // draft | published
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}
