generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Tenant (empresa/conta). Todo dado do admin pertence a um tenant.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users             AdminUser[]
  documents         Document[]
  conversations     Conversation[]
  availabilitySlots AvailabilitySlot[]
  meetings          Meeting[]
  settings          Setting[]
  news              News[]
  videoPosts        VideoPost[]
  videoScripts      VideoScript[]
  videoPrompts      VideoPrompt[]
}

model AdminUser {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  passwordHash String
  role         String   @default("member") // admin | member
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([email])
}

/// Base de conhecimento: documentos .md sobre a empresa
model Document {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  filename  String?
  content   String   @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Uma conversa por contato de WhatsApp
model Conversation {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waPhone       String
  contactName   String?
  status        String    @default("ativo") // ativo | agendado | fechado
  reportJson    String?   @db.Text // relatório gerado por IA (JSON)
  reportAt      DateTime?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]
  meetings      Meeting[]

  @@unique([tenantId, waPhone])
  @@index([tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // in | out
  type           String       @default("text") // text | image | audio
  content        String       @db.Text // texto, transcrição de áudio ou descrição de imagem
  mediaUrl       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
  meeting   Meeting?

  @@index([tenantId])
}

model Meeting {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  slotId         String           @unique
  slot           AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clientName     String
  clientPhone    String?
  clientEmail    String?
  notes          String?          @db.Text
  status         String           @default("confirmado") // confirmado | cancelado | realizado
  createdAt      DateTime         @default(now())

  @@index([tenantId])
}

/// Configurações (chave/valor) por tenant. Segredos podem vir daqui ou do .env.
model Setting {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  value    String @db.Text

  @@id([tenantId, key])
}

/// Notícias do portal de IA
model News {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  category      String   @default("Novidades") // Novidades | Pesquisa | Produto | Política | Opinião | Mercado
  excerpt       String   @db.Text // resumo curto exibido nos cards
  content       String   @db.Text // corpo em markdown
  coverImageUrl String? // imagem de capa (Azure Blob)
  mediaType     String   @default("image") // image | video
  mediaUrl      String? // vídeo (Azure Blob) quando mediaType = video
  author        String?
  source        String?
  sourceUrl     String?
  tags          String?  @db.Text // tags separadas por vírgula
  featured      Boolean  @default(false) // destaque no topo do portal
  status        String   @default("published") // draft | published
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([status, publishedAt])
  @@index([category])
  @@index([tenantId])
}

/// Agendamento de postagens de vídeo (calendário editorial)
model VideoPost {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  prompt            String   @db.Text // prompt do roteiro
  accountName       String // conta que fará a postagem
  scheduledAt       DateTime
  platformInstagram Boolean  @default(false)
  platformYoutube   Boolean  @default(false)
  platformTiktok    Boolean  @default(false)
  platformKwai      Boolean  @default(false)
  autoSend          Boolean  @default(false)
  voiceId           String? // voz do ElevenLabs para a narração deste vídeo (null = padrão)
  format            String   @default("vertical") // vertical (Short 9:16) | horizontal (16:9)
  resolution        String   @default("fullhd") // fullhd | 4k
  style             String   @default("cinematic") // cinematic | anime | cartoon2d | presentation
  // Fluxo do pipeline: draft | scheduled | generating_script | script_ready |
  // generating_assets | assembling | sending | sent | failed
  status            String   @default("scheduled")
  finalVideoUrl     String? // vídeo final montado (Azure Blob)
  error             String?  @db.Text // último erro do pipeline
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  script VideoScript?

  @@index([scheduledAt])
  @@index([status])
  @@index([tenantId])
}

/// Roteiro gerado por IA para uma postagem de vídeo (até ~1h de conteúdo)
model VideoScript {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  videoPostId String   @unique
  videoPost   VideoPost @relation(fields: [videoPostId], references: [id], onDelete: Cascade)
  content     String   @db.LongText // roteiro completo (campo grande)
  status      String   @default("ready") // ready | failed
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prompts VideoPrompt[]

  @@index([tenantId])
}

/// Prompts de vídeo: roteiro dividido em cenas sequenciais para geração
model VideoPrompt {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scriptId  String
  script    VideoScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  sequence  Int // ordem da cena no vídeo final
  prompt    String      @db.Text // prompt visual da cena (Gemini/Veo)
  narration String?     @db.Text // texto de narração da cena (ElevenLabs)
  videoUrl  String? // clipe gerado (Azure Blob)
  audioUrl  String? // narração gerada (Azure Blob)
  status    String      @default("pending") // pending | video_done | audio_done | done | failed
  error     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([scriptId, sequence])
  @@index([tenantId])
}
