generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Base de conhecimento: documentos .md sobre a empresa
model Document {
  id        String   @id @default(cuid())
  title     String
  filename  String?
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Uma conversa por contato de WhatsApp
model Conversation {
  id            String    @id @default(cuid())
  waPhone       String    @unique
  contactName   String?
  status        String    @default("ativo") // ativo | agendado | fechado
  reportJson    String? // relatório gerado por IA (JSON)
  reportAt      DateTime?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]
  meetings      Meeting[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // in | out
  type           String       @default("text") // text | image | audio
  content        String // texto, transcrição de áudio ou descrição de imagem
  mediaUrl       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model AvailabilitySlot {
  id        String    @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  isBooked  Boolean   @default(false)
  createdAt DateTime  @default(now())
  meeting   Meeting?
}

model Meeting {
  id             String            @id @default(cuid())
  conversationId String?
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  slotId         String            @unique
  slot           AvailabilitySlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clientName     String
  clientPhone    String?
  clientEmail    String?
  notes          String?
  status         String            @default("confirmado") // confirmado | cancelado | realizado
  createdAt      DateTime          @default(now())
}

/// Configurações (chave/valor). Segredos podem vir daqui ou do .env.
model Setting {
  key   String @id
  value String
}
